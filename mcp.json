{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "telegram": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/bin/channel.mjs"
      ],
      "cwd": "${PLUGIN_ROOT}"
    },
    "setup": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/bin/status.mjs"
      ]
    }
  }
}
